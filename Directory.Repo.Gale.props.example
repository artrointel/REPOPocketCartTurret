<Project>
  <PropertyGroup>
    <!-- Steam R.E.P.O. installation folder. Optional if detected automatically by the SDK. -->
    <GameDirectory>C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDirectory>

    <!-- Gale development profile settings -->
    <ProfileName>Mod Dev</ProfileName>
    <BepInExDirectory>$(AppData)\com.kesomannen.gale\repo\profiles\$(ProfileName)\BepInEx</BepInExDirectory>
    <StartArguments>--doorstop-enabled true --doorstop-target-assembly &quot;$(BepInExDirectory)\core\BepInEx.Preloader.dll&quot; --gale-profile &quot;$(ProfileName)&quot;</StartArguments>
  </PropertyGroup>
</Project>
